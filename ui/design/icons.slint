// Icons: every Lucide SVG in ui/icons as an image property, so pages can write `Icons.play`.
// Generated from the folder listing. After adding icons (tools/icons/icons.txt + extract-lucide.mjs), regenerate:
//   cd ui && (for f in icons/*.svg; do n=$(basename "$f" .svg); echo "    out property <image> $n: @image-url(\"../icons/$n.svg\");"; done)
// and paste the lines into the global below (keep the header and the filled transport glyphs at the end).
// The SVGs are white strokes: recolour with `Icon { color: ... }` or `Image { colorize: ... }`.
//
// Filled transport glyphs (ui/design/glyphs, Lucide geometry with a fill): use them inside solid circles
// (IconButtonKind.primary Play / Pause, the widget's transport), where outline bars read as "00".
//   play-fill, pause-fill, skip-back-fill, skip-forward-fill

export global Icons {
    out property <image> play-fill: @image-url("glyphs/play-fill.svg");
    out property <image> pause-fill: @image-url("glyphs/pause-fill.svg");
    out property <image> skip-back-fill: @image-url("glyphs/skip-back-fill.svg");
    out property <image> skip-forward-fill: @image-url("glyphs/skip-forward-fill.svg");

    out property <image> app-window: @image-url("../icons/app-window.svg");
    out property <image> arrow-left: @image-url("../icons/arrow-left.svg");
    out property <image> arrow-right: @image-url("../icons/arrow-right.svg");
    out property <image> arrow-up-right: @image-url("../icons/arrow-up-right.svg");
    out property <image> audio-lines: @image-url("../icons/audio-lines.svg");
    out property <image> badge-check: @image-url("../icons/badge-check.svg");
    out property <image> bell: @image-url("../icons/bell.svg");
    out property <image> calendar: @image-url("../icons/calendar.svg");

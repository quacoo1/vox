// Settings → Voice providers: one card per service (Windows voices, Amazon Polly, Azure, OpenAI, Google Cloud).
//
// A card shows the service, its connection status and, when not connected (or while changing keys), a setup form:
// the key field, an optional second secret field (Polly), an optional region picker (Polly, Azure), Connect and a
// link to where the keys are made. Built-in services (Windows) have no form. The drafts live in each card (never in
// Rust data) and are cleared when the service becomes connected. Rust validates and answers through the card data
// (`busy`, `error`).
import { Theme, Icons, Icon, Button, ButtonKind, ButtonSize, TextField, FormField, Select, Badge, BadgeKind, BadgeDot,
    Divider } from "../../design/index.slint";
import { ProviderCardData } from "../../models.slint";
import { SectionHead, WrapText, AlertLine } from "parts.slint";

component ProviderTile inherits Rectangle {
    in property <image> icon;
    width: 40px;
    height: 40px;
    border-radius: Theme.radius-thumb;
    background: Theme.chip;
    border-width: Theme.hairline;
    border-color: Theme.field-border;
    accessible-role: none;
    Icon {
        width: 100%;
        height: 100%;
        source: root.icon;
        size: 18px;
        color: Theme.text;
    }
}

component ProviderCard inherits Rectangle {
    in property <ProviderCardData> card;

    callback connect(string, string, int);
    callback disconnect();
    callback edited();
    callback open-link(string);

    property <bool> editing: false;
    property <string> key-draft;
    property <string> secret-draft;
    property <int> region-index: root.card.region-index;
    property <bool> show-form: !root.card.built-in && (!root.card.connected || root.editing);
    property <bool> has-secret: root.card.secret-label != "";
    property <bool> has-region: root.card.region-options.length > 0;
    property <length> body-width: max(0px, root.width - 40px - Theme.space-4);

    changed card => {
        if (root.card.connected && !root.card.busy && root.card.error == "") {
            root.editing = false;
            root.key-draft = "";
            root.secret-draft = "";
        }
        root.region-index = root.card.region-index;
    }

    min-width: 0px;
    preferred-width: 0px;
    max-width: 100000px;
    horizontal-stretch: 1;
    background: transparent;
    accessible-role: groupbox;
    accessible-label: root.card.name;

    HorizontalLayout {
        spacing: Theme.space-4;

        VerticalLayout {
            alignment: start;
            ProviderTile { icon: root.card.built-in ? Icons.monitor : Icons.globe; }
        }

        VerticalLayout {
            width: root.body-width;
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                Text {
                    text: root.card.name;
                    font-family: Theme.font-text;
                    font-size: Theme.size-body;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                if root.card.connected: Badge {
                    text: root.card.built-in ? "Built in" : "Connected";
                    dot: BadgeDot.success;
                    kind: BadgeKind.filled;
                }
            }

            WrapText {
                width: root.body-width;
                text: root.card.connected && !root.card.built-in ? root.card.status : root.card.description;
            }
            if root.card.built-in && root.card.status != "": WrapText {
                width: root.body-width;
                text: root.card.status;
            }
            if root.card.timing-note != "": WrapText {
                width: root.body-width;
                text: root.card.timing-note;
            }

            if root.card.connected && !root.card.built-in && !root.editing: HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                padding-top: Theme.space-2;
                Button {
                    text: "Change key";
                    size: ButtonSize.sm;
                    clicked => { root.editing = true; }
                }
                Button {
                    text: "Disconnect";
                    kind: ButtonKind.danger;
                    size: ButtonSize.sm;
                    loading: root.card.busy;
                    clicked => { root.disconnect(); }
                }
            }

            if root.show-form: VerticalLayout {
                width: root.body-width;
                spacing: Theme.space-4;
                padding-top: Theme.space-2;

                FormField {
                    label: root.card.key-label;
                    TextField {
                        text <=> root.key-draft;
                        icon: Icons.key-round;
                        placeholder: root.card.key-placeholder;
                        password: !root.has-secret;
                        label: root.card.key-label;
                        has-error: root.card.error != "";
                        edited => { root.edited(); }
                        accepted(t) => {
                            if (!root.has-secret) {
                                root.connect(t, "", root.region-index);
                            }
                        }
                    }
                }
                if root.has-secret: FormField {
                    label: root.card.secret-label;
                    TextField {
                        text <=> root.secret-draft;
                        icon: Icons.lock;
                        placeholder: root.card.secret-label;
                        password: true;
                        label: root.card.secret-label;
                        has-error: root.card.error != "";
                        edited => { root.edited(); }
                        accepted(t) => { root.connect(root.key-draft, t, root.region-index); }
                    }
                }
                if root.has-region: FormField {
                    label: "Region";
                    hint: root.card.region-hint;
                    Select {
                        model: root.card.region-options;
                        current-index: root.region-index;
                        label: "Region";
                        selected(i, v) => { root.region-index = i; }
                    }
                }

                if root.card.error != "": AlertLine {
                    width: root.body-width;
                    text: root.card.error;
                }

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    Button {
                        text: root.card.connected ? "Save" : "Connect";
                        kind: ButtonKind.primary;
                        size: ButtonSize.sm;
                        loading: root.card.busy;
                        clicked => { root.connect(root.key-draft, root.secret-draft, root.region-index); }
                    }
                    if root.card.connected: Button {
                        text: "Cancel";
                        size: ButtonSize.sm;
                        enabled: !root.card.busy;
                        clicked => {
                            root.editing = false;
                            root.key-draft = "";
                            root.secret-draft = "";
                        }
                    }
                    if root.card.keys-url != "": Button {
                        text: "Get a key";
                        kind: ButtonKind.ghost;
                        size: ButtonSize.sm;
                        trailing-icon: Icons.arrow-up-right;
                        clicked => { root.open-link(root.card.keys-url); }
                    }
                }
            }
        }
    }
}

export component ProvidersSection inherits Rectangle {
    in property <[ProviderCardData]> cards;

    // (provider id, key, secret, region index)
    callback provider-connect(string, string, string, int);
    callback provider-disconnect(string);
    callback provider-edited(string);
    callback open-link(string);

    min-width: 0px;
    preferred-width: 0px;
    max-width: 100000px;
    horizontal-stretch: 1;
    background: transparent;
    accessible-role: groupbox;
    accessible-label: "Voice providers";

    VerticalLayout {
        spacing: Theme.space-5;

        SectionHead {
            title: "Voice providers";
        }

        WrapText {
            width: root.width;
            text: "Use voices from other services alongside ElevenLabs. Their voices appear on the Voices page, and each service bills its own account.";
        }

        for card[i] in root.cards: VerticalLayout {
            spacing: Theme.space-5;
            if i > 0: Divider { }
            ProviderCard {
                card: card;
                connect(k, s, r) => { root.provider-connect(card.id, k, s, r); }
                disconnect => { root.provider-disconnect(card.id); }
                edited => { root.provider-edited(card.id); }
                open-link(u) => { root.open-link(u); }
            }
        }
    }
}
